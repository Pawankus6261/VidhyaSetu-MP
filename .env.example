# VidyaSetu MP Environment Configuration Sample

# Application Core
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=change_this_to_a_secure_random_string_32_bytes_min
API_PORT=8000

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vidyasetu_mp
POSTGRES_USER=vidyasetu
POSTGRES_PASSWORD=vidyasetu_secure_password_2026

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=mp_curriculum_knowledge

# Redis Caching & Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# Object Storage (MinIO / S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=vidyasetu_admin
STORAGE_SECRET_KEY=vidyasetu_storage_password_2026
STORAGE_BUCKET_NAME=vidyasetu-packs

# Indic AI Speech Services
BHASHINI_USER_ID=sample_bhashini_user_id
BHASHINI_API_KEY=sample_bhashini_api_key
BHASHINI_PIPELINE_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
