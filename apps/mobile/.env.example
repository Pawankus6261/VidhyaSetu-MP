# VidyaSetu MP (विद्यासेतु) — Mobile Frontend Environment Configuration
# Copy this file to .env or .env.local for local overrides

# Cloud Gateway API Base URL
# For Android Emulator: http://10.0.2.2:8000
# For Web Browser / Local Desktop: http://127.0.0.1:8000
# For Physical Android Device over LAN: http://<YOUR_LAN_IP>:8000
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Client Environment (development | staging | production)
EXPO_PUBLIC_ENVIRONMENT=development

# Offline Outbox Burst Sync Interval in milliseconds (default: 8000ms)
EXPO_PUBLIC_SYNC_INTERVAL_MS=8000

# Low-Bandwidth Request Timeout in milliseconds (default: 9000ms for 2G/3G bursts)
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=9000
